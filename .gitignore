.DS_Store
/.build
/Packages
xcuserdata/
DerivedData/
.swiftpm/configuration/registries.json
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
.netrc

# Voice recordings: large binary assets, kept out of git history.
recordings/raw/
recordings/wav/
recordings/*.csv
# Reading sheets ARE tracked: they are the transcript of record for each
# session, and a recording is worthless without knowing exactly what was read.
!recordings/scripts/
*.wav
!Tests/**/*.wav

# Everything under recordings/ is private working data -- audio, manifests,
# and transcripts that may contain copyrighted text -- except the README and
# the public-domain reading sheets.
recordings/*
!recordings/README.md
!recordings/scripts/
